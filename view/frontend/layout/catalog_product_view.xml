<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- After the snippet, so the brand ID is the first call in window.omnisend -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="magelan.omnisend.product"
                   template="Magelan_Omnisend::product.phtml" after="magelan.omnisend.snippet">
                <arguments>
                    <argument name="view_model" xsi:type="object">Magelan\Omnisend\ViewModel\Tracking</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
