<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magelan_omnisend>
            <general>
                <enabled>0</enabled>
                <api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <api_url>https://api.omnisend.com</api_url>
                <api_version>2026-03-15</api_version>
                <debug>0</debug>
            </general>
            <tracking>
                <snippet>1</snippet>
                <consent_mode>cookie</consent_mode>
                <consent_group>marketing</consent_group>
                <viewed_product>1</viewed_product>
            </tracking>
            <events>
                <added_to_cart>1</added_to_cart>
                <started_checkout>1</started_checkout>
                <orders>1</orders>
                <tracking_urls><![CDATA[gls | https://gls-group.com/SI/en/parcel-tracking?match={number}
posta | https://sledenje.posta.si/Default.aspx?tn={number}&lang=si
pošta | https://sledenje.posta.si/Default.aspx?tn={number}&lang=si
dpd | https://tracking.dpd.de/status/sl_SI/parcel/{number}
expressone | https://inet.expressone.si/sledenje?id={number}
ups | https://www.ups.com/track?tracknum={number}
dhl | https://www.dhl.com/global-en/home/tracking/tracking-express.html?tracking-id={number}
fedex | https://www.fedex.com/fedextrack/?trknbr={number}
usps | https://tools.usps.com/go/TrackConfirmAction?tLabels={number}]]></tracking_urls>
            </events>
            <contacts>
                <newsletter>1</newsletter>
                <customers>1</customers>
                <orders>1</orders>
            </contacts>
            <catalog>
                <products>1</products>
                <categories>1</categories>
            </catalog>
            <queue>
                <batch_size>100</batch_size>
                <max_attempts>6</max_attempts>
                <keep_days>30</keep_days>
            </queue>
        </magelan_omnisend>
    </default>
</config>
