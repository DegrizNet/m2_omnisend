<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_item_save_after">
        <observer name="magelan_omnisend_added_to_cart" instance="Magelan\Omnisend\Observer\QuoteItemSaved"/>
    </event>
    <!-- Standard checkout and Swissup Firecheckout (which serves /checkout from its own action) -->
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="magelan_omnisend_started_checkout" instance="Magelan\Omnisend\Observer\CheckoutOpened"/>
    </event>
    <event name="controller_action_predispatch_firecheckout_index_index">
        <observer name="magelan_omnisend_started_checkout" instance="Magelan\Omnisend\Observer\CheckoutOpened"/>
    </event>
</config>
