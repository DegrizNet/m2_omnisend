<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Orders (any area: storefront, admin, API, payment callbacks) -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="magelan_omnisend_order" instance="Magelan\Omnisend\Observer\OrderChanged"/>
    </event>
    <event name="sales_order_invoice_save_after">
        <observer name="magelan_omnisend_order" instance="Magelan\Omnisend\Observer\OrderChanged"/>
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="magelan_omnisend_order" instance="Magelan\Omnisend\Observer\OrderChanged"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="magelan_omnisend_order" instance="Magelan\Omnisend\Observer\OrderChanged"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="magelan_omnisend_order" instance="Magelan\Omnisend\Observer\OrderChanged"/>
    </event>

    <!-- Contacts -->
    <event name="newsletter_subscriber_save_after">
        <observer name="magelan_omnisend_subscriber" instance="Magelan\Omnisend\Observer\SubscriberSaved"/>
    </event>
    <event name="customer_save_after_data_object">
        <observer name="magelan_omnisend_customer" instance="Magelan\Omnisend\Observer\CustomerSaved"/>
    </event>

    <!-- Catalog -->
    <event name="catalog_product_save_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="catalog_product_attribute_update_before">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="catalog_product_import_bunch_save_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="cataloginventory_stock_item_save_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="catalog_category_save_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>
    <event name="catalog_category_delete_after">
        <observer name="magelan_omnisend_catalog" instance="Magelan\Omnisend\Observer\CatalogChanged"/>
    </event>

    <!-- Swissup GDPR: declare the snippet's cookies (ignored when the module is not installed) -->
    <event name="swissup_gdpr_cookies_load_before">
        <observer name="magelan_omnisend_gdpr_cookies" instance="Magelan\Omnisend\Observer\RegisterGdprCookies"/>
    </event>
</config>
